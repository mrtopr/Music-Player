{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index?__vpath="
    },
    {
      "source": "/docs",
      "destination": "/api/index?__vpath=docs"
    },
    {
      "source": "/swagger",
      "destination": "/api/index?__vpath=swagger"
    }
  ]
}
