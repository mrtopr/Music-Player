# Copy this file to .env and fill in your values.
# DO NOT commit your actual .env file — it's gitignored.

# PostgreSQL connection string (Neon, Railway, Supabase, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT secret (kept for future auth, not used yet)
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_HERE

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:5173

# AudD API token for Shazam-style recognition (optional)
AUDD_API_TOKEN=

# Last.fm API key for scrobbling (optional)
LASTFM_API_KEY=
LASTFM_API_SECRET=

# ListenBrainz token for scrobbling (optional)
LISTENBRAINZ_TOKEN=
