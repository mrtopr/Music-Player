# Copy this file to .env and fill in your values.
# DO NOT commit your actual .env file — it's gitignored.

# PostgreSQL connection string (Neon, Railway, Supabase, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT secret for signing auth tokens — use a long random string in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_HERE

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=https://your-app.vercel.app,http://localhost:5173
