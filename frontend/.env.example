# Copy this file to .env and fill in your values.
# DO NOT commit your actual .env file — it's gitignored.

# Dev server port (optional, defaults to 5173 for Vite)
PORT=3000

# Backend API base URL (leave empty to use Vite proxy in dev)
# In production, set this to your deployed backend URL.
VITE_API_URL=https://your-backend.workers.dev

# ML microservice URL (optional — AI recommendations feature)
VITE_ML_SERVICE_URL=http://localhost:8000

# PieSocket API key for Listen Together real-time sync (optional)
# Get a free key at https://www.piesocket.com/
# If not set, falls back to a public demo key with rate limits.
VITE_PIESOCKET_API_KEY=your_piesocket_api_key_here
