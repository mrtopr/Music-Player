{
  "name": "mehfil-backend-fresh",
  "version": "1.0.0",
  "description": "Freshly rebuilt music backend for Mehfil — same JioSaavn logic, BitChord-inspired features, no auth, no Spotify",
  "type": "module",
  "license": "MIT",
  "main": "src/server.ts",
  "scripts": {
    "dev": "npx tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-openapi": "^0.19.2",
    "@prisma/client": "^6.0.0",
    "@scalar/hono-api-reference": "^0.7.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "hono": "^4.7.5",
    "jsonwebtoken": "^9.0.3",
    "node-forge": "^1.3.1",
    "zod": "^3.24.2"
  },
  "imports": {
    "#modules/*": "./src/modules/*",
    "#common/*": "./src/common/*",
    "#common/helpers": "./src/common/helpers/index.ts",
    "#modules/modules/helpers": "./src/modules/modules/helpers/index.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.14",
    "@types/node-forge": "^1.3.11",
    "effect": "^4.1.4",
    "prisma": "^6.0.0",
    "tsc-alias": "^1.8.13",
    "tsx": "^4.23.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "wrangler": "^4.6.0"
  }
}
