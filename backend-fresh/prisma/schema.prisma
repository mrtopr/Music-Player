generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String?
  profileImageUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  playbackEvents   PlaybackEvent[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
}

model Track {
  id          String   @id // JioSaavn Track ID or internal UUID
  name        String?
  artist      String?
  album       String?
  durationMs  Int?
  genre       String?
  bpm         Int?

  playbackEvents PlaybackEvent[]
  playlistTracks PlaylistTrack[]
  favorites      Favorite[]
}

model PlaybackEvent {
  id                 String   @id @default(uuid())
  user               User     @relation(fields: [userId], references: [id])
  userId             String
  track              Track    @relation(fields: [trackId], references: [id])
  trackId            String
  sessionId          String   @default(uuid())
  eventType          String   // play_started, play_completed, skipped, repeated
  timestamp          DateTime @default(now())
  contextSource      String?  // search, playlist, auto-queue
  contextPlaylistId  String?
  durationListenedMs Int?

  @@index([userId, timestamp])
  @@index([trackId, eventType])
}

model Playlist {
  id          String   @id @default(uuid())
  name        String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tracks   PlaylistTrack[]
}

model PlaylistTrack {
  id        String   @id @default(uuid())
  playlist  Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String
  track     Track    @relation(fields: [trackId], references: [id])
  trackId   String
  position  Int
  addedAt   DateTime @default(now())

  @@unique([playlistId, trackId])
  @@index([playlistId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   // session ID or user id (auth optional)
  track     Track    @relation(fields: [trackId], references: [id])
  trackId   String
  createdAt DateTime @default(now())

  @@unique([userId, trackId])
  @@index([userId])
}

model DownloadedTrack {
  id          String   @id @default(uuid())
  userId      String
  trackId     String
  filePath    String?
  fileSize    Int?
  status      String   @default("pending") // pending, completed, failed
  downloadedAt DateTime?

  @@index([userId])
}
